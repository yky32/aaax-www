---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const SITE = "https://aaax-www.vercel.app";
const {
  title = "AAAX — self-host OpenID Connect authentication server",
  description =
    "Self-host OIDC for Spring/JVM teams. Boot 4.1.1 · Java 21 · PKCE · hosted login. Apache-2.0.",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImage = `${SITE}/og.png`;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "AAAX",
      url: `${SITE}/`,
      description,
    },
    {
      "@type": "SoftwareSourceCode",
      name: "AAAX",
      description:
        "Self-host OpenID Connect authorization server as one Spring Boot jar. PKCE, hosted /login, Java 21.",
      url: `${SITE}/`,
      codeRepository: "https://github.com/yky32/aaax",
      license: "https://www.apache.org/licenses/LICENSE-2.0",
      programmingLanguage: "Java",
      runtimePlatform: "Java 21, Spring Boot 4.1.1",
      sameAs: ["https://github.com/yky32/aaax"],
      author: {
        "@type": "Person",
        name: "Wayne Yu",
        url: "https://github.com/yky32",
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f6f3ec" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AAAX — self-host OIDC, one Spring jar" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
