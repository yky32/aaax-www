---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "AAAX — self-host OpenID Connect authentication server",
  description =
    "Self-host OIDC for Spring/JVM teams. Boot 4.1.1 · Java 21 · PKCE · hosted login. Apache-2.0.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content="AAAX" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
