---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "AAAX — Identity you run. Signals you own.",
  description = "Self-host OIDC for Spring and platform teams. Lean issuer + Identity Event Bus — your mesh notifies, you keep SMS.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content="AAAX" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="mesh min-h-screen text-[var(--ink)] antialiased">
    <div class="pointer-events-none fixed inset-0 grid-fade" aria-hidden="true"></div>
    <slot />
  </body>
</html>
