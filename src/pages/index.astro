---
import Layout from "../layouts/Layout.astro";
import FlowStage from "../components/FlowStage.astro";

const GH = "https://github.com/yky32/aaax";
const README = "https://github.com/yky32/aaax/blob/main/README.md";

const modules = [
  {
    t: "com.aaax.server.*",
    d: "qs/uaa 1:1 — OIDC AS, accounts, OTP, devices, social, admin. Same tree as upstream uaa.",
  },
  {
    t: "com.aaax.core.*",
    d: "qs app-core in the same project — BizException, R/Result, AuditEntity, SystemResponse. No private Maven module.",
  },
];

const fromUaa = [
  { t: "OIDC Authorization Server", d: "Spring Authorization Server — code, refresh, client credentials." },
  { t: "User · Authentication model", d: "uaa PO tree: user / authentication / devices / tokens / RBAC." },
  { t: "OTP & password flows", d: "uaa use cases + error codes (UAA/OTP/ACC style Response codes)." },
  { t: "Social auth extensions", d: "uaa social_auth config extensions (Google etc.)." },
  { t: "Redis · Kafka · Liquibase", d: "Same ops surface as qs uaa." },
  { t: "Exception envelope", d: "throw new BizException(Response) → R/Result — app-core shape." },
];
---

<Layout
  title="AAAX — qs/uaa open-sourced"
  description="AAAX is a 1:1 open-source port of qs/uaa with app-core vendored as com.aaax.core. Spring Boot 3.1 · Apache-2.0."
>
  <div class="wrap wrap--wide">
    <header class="flex items-start justify-between gap-4">
      <div>
        <p class="mono text-sm font-medium tracking-wide">AAAX</p>
        <p class="mt-1 text-sm text-[var(--muted)]">
          Accounts · Authentication · Authorization · eXperiences
        </p>
      </div>
      <a
        class="mono text-sm underline underline-offset-4 decoration-[var(--line)] hover:decoration-[var(--ink)]"
        href={GH}>GitHub ↗</a
      >
    </header>

    <p class="stamp mt-7">
      <span class="dot" aria-hidden="true"></span>
      0.9.0-SNAPSHOT · Apache-2.0 · Boot&nbsp;3.1 · JDK&nbsp;17+
    </p>

    <h1 class="serif mt-4 text-[2.2rem] leading-[1.12] md:text-[2.85rem] md:leading-[1.08]">
      qs/<span class="mark">uaa</span> · open source · your mesh.
    </h1>

    <p class="mt-4 text-[1.02rem] text-[var(--muted)]">
      <strong class="font-medium text-[var(--ink)]">AAAX</strong> is not a greenfield rewrite.
      It is a <strong class="font-medium text-[var(--ink)]">1:1 port of qs/uaa</strong> with
      <strong class="font-medium text-[var(--ink)]">app-core vendored</strong> as
      <span class="mono text-[0.9rem]">com.aaax.core</span> — one public repo, no private Maven.
    </p>

    <div class="mt-6 flex flex-wrap gap-2.5">
      <a class="btn btn-fill" href={GH}>Open the repo</a>
      <a class="btn btn-ghost" href={README}>README</a>
      <a class="btn btn-ghost" href="/mcp-auth">MCP Auth</a>
    </div>

    <section class="mt-11" aria-labelledby="flow">
      <h2 id="flow" class="serif text-[1.65rem] md:text-2xl">Login → Spring → mesh</h2>
      <p class="mt-2 text-sm text-[var(--muted)]">
        Same idea as before: authenticate in AAAX; notify from your stack.
      </p>
      <FlowStage />
    </section>

    <hr class="rule" />

    <section id="modules" aria-labelledby="mod">
      <h2 id="mod" class="serif text-[1.65rem] md:text-2xl">Repository layout</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          modules.map((m) => (
            <article class="card card--accent">
              <h3 class="mono text-[0.95rem]">{m.t}</h3>
              <p>{m.d}</p>
            </article>
          ))
        }
      </div>
      <div class="shell mt-4">
        <div class="shell-bar">clone · build · run</div>
        <pre><code>git clone https://github.com/yky32/aaax.git && cd aaax
export JAVA_HOME=…/openjdk@21   <span class="c"># 17+ ; avoid JDK 26 + old lombok</span>
mvn -DskipTests package
java -jar target/aaax-0.9.0-SNAPSHOT.jar
<span class="c"># :8081 — same default as qs uaa</span></code></pre>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="feat">
      <h2 id="feat" class="serif text-[1.65rem] md:text-2xl">From qs/uaa (now OSS)</h2>
      <p class="mt-2 text-[var(--muted)]">
        Feature surface follows the uaa tree — not an invented AAAX-only matrix.
      </p>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          fromUaa.map((f) => (
            <article class="card">
              <h3>{f.t}</h3>
              <p>{f.d}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mt-12" aria-labelledby="line">
      <h2 id="line" class="serif text-[1.65rem] md:text-2xl">Positioning</h2>
      <blockquote
        class="serif m-0 mt-3 border-l-[3px] border-[var(--accent)] pl-4 text-[1.55rem] leading-snug md:text-[1.7rem]"
      >
        AAAX authenticates.<br />Your mesh notifies.
      </blockquote>
      <p class="mt-4 text-sm text-[var(--muted)]">
        Product name: <strong class="text-[var(--ink)]">AAAX</strong> · upstream craft:
        <strong class="text-[var(--ink)]">qs/uaa + app-core</strong> · license Apache-2.0
      </p>
    </section>

    <footer class="site">
      <p>
        AAAX by <a href="https://github.com/yky32">yky32</a> · port of qs/uaa · core in-tree
      </p>
    </footer>
  </div>
</Layout>
