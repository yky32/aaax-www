---
import Layout from "../layouts/Layout.astro";

const GH = "https://github.com/yky32/aaax";
const RELEASE = "https://github.com/yky32/aaax/releases/tag/v0.7.0";
const BOOKLET = "https://github.com/yky32/aaax/blob/main/docs/booklet.md";
const MESH = "https://github.com/yky32/aaax/tree/main/examples/compose-mesh";
---

<Layout>
  <div class="wrap">
    <header class="flex items-start justify-between gap-4">
      <div>
        <p class="mono text-sm font-medium tracking-wide">AAAX</p>
        <p class="mt-1 text-sm text-[var(--muted)]">for Spring / platform teams</p>
      </div>
      <a class="mono text-sm underline underline-offset-4 decoration-[var(--line)] hover:decoration-[var(--ink)]" href={GH}
        >GitHub ↗</a
      >
    </header>

    <p class="stamp mt-8">
      <span class="dot" aria-hidden="true"></span>
      v0.7.0 · Apache-2.0 · JDK&nbsp;21
    </p>

    <h1 class="serif mt-5 text-[2.35rem] leading-[1.12] md:text-[3.1rem] md:leading-[1.08]">
      The IdP that <span class="mark">talks to your mesh</span>, not a SaaS seat counter.
    </h1>

    <p class="mt-5 text-[1.05rem] text-[var(--muted)]">
      AAAX is a self-host OpenID Connect server on Spring Boot. Login stays in one jar. Lifecycle signals leave as
      events — Kafka or webhook — so <strong class="font-medium text-[var(--ink)]">your</strong> notification service
      still owns SMS and email.
    </p>

    <div class="mt-7 flex flex-wrap gap-2.5">
      <a class="btn btn-fill" href={GH}>Open the repo</a>
      <a class="btn btn-ghost" href={BOOKLET}>Read the booklet</a>
      <a class="btn btn-ghost" href={RELEASE}>v0.7.0</a>
    </div>

    <!-- one picture of the idea -->
    <section class="mt-12" aria-labelledby="idea">
      <h2 id="idea" class="serif text-2xl md:text-[1.75rem]">One idea, three hops</h2>
      <ol class="flow mt-5">
        <li>
          <span class="n">01</span>
          <div class="b">
            <p class="m-0 font-medium">User signs in on AAAX</p>
            <p class="m-0 mt-1 text-sm text-[var(--muted)]">
              Password, OTP, magic link, QR, TOTP, optional social / passkeys. Hosted
              <span class="mono">/sign-in</span> in the same jar.
            </p>
          </div>
        </li>
        <li>
          <span class="n">02</span>
          <div class="b">
            <p class="m-0 font-medium">Spring issues OIDC tokens</p>
            <p class="m-0 mt-1 text-sm text-[var(--muted)]">
              Authorization Server: discovery, JWKS, code + PKCE, refresh, client credentials. Your SPA or resource
              server validates JWT.
            </p>
          </div>
        </li>
        <li>
          <span class="n">03</span>
          <div class="b">
            <p class="m-0 font-medium">Events hit your platform</p>
            <p class="m-0 mt-1 text-sm text-[var(--muted)]">
              CloudEvents catalog → Kafka topic and/or HMAC webhook. Notify, audit, fraud — already your stack.
            </p>
          </div>
        </li>
      </ol>
    </section>

    <hr class="rule" />

    <section aria-labelledby="run">
      <h2 id="run" class="serif text-2xl">Five minutes, no account</h2>
      <p class="mt-2 text-[var(--muted)]">Clone. Test. Run. No private Maven.</p>
      <div class="shell mt-4">
        <div class="shell-bar">terminal · local</div>
        <pre><code><span class="c"># JDK 21+</span>
git clone https://github.com/yky32/aaax.git && cd aaax
git checkout v0.7.0
mvn test && mvn spring-boot:run

<span class="c"># http://localhost:8081 · demo / demo1234</span>
./examples/curl/get-token-and-hello.sh</code></pre>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="fit">
      <h2 id="fit" class="serif text-2xl">Built for this desk</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        <article class="card">
          <h3>You already have a mesh</h3>
          <p>Kafka / notify service exists. You refuse Twilio locked inside the IdP.</p>
        </article>
        <article class="card">
          <h3>You read Spring code</h3>
          <p>
            <span class="mono text-[0.8rem]">endpoint/</span> ·
            <span class="mono text-[0.8rem]">usecase/</span> ·
            <span class="mono text-[0.8rem]">entity/</span> — layer-first, qs-style neat.
          </p>
        </article>
        <article class="card">
          <h3>You want lean OIDC</h3>
          <p>Not a 400-feature console. One <span class="mono text-[0.8rem]">application.yml</span>, Helm env for prod.</p>
        </article>
        <article class="card">
          <h3>You are fine saying no</h3>
          <p>Not full Keycloak. Not Clerk UI kit. Orgs / SAML IdP wait until someone actually needs them.</p>
        </article>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="line">
      <h2 id="line" class="serif text-2xl">The line we keep repeating</h2>
      <blockquote
        class="serif m-0 mt-4 border-l-[3px] border-[var(--accent)] pl-4 text-2xl leading-snug text-[var(--ink)] md:text-[1.85rem]"
      >
        AAAX authenticates.<br />
        Your mesh notifies.
      </blockquote>
      <p class="mt-4 text-sm text-[var(--muted)]">
        Full bus path:
        <a class="underline underline-offset-3" href={MESH}>examples/compose-mesh</a>
        · deep dive:
        <a class="underline underline-offset-3" href={BOOKLET}>docs/booklet.md</a>
      </p>
    </section>

    <footer class="site">
      <p>
        AAAX by <a href="https://github.com/yky32">yky32</a> · site is quiet on purpose · product is the jar
      </p>
    </footer>
  </div>
</Layout>
